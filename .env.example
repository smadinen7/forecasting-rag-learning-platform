# Personal Learning Portal - Environment Configuration
# Copy this file to .env and add your API keys

# Provider Selection
# Options: "gemini" | "openai" | "none"
PROVIDER=gemini

# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (optional fallback, get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
